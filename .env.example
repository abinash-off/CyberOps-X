# CyberOps-X configuration template
NODE_ENV=development
PORT=4000

# Authentication - generate a strong random value locally; never commit the real secret
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/cyberops_x

# Internal service endpoints (optional during UI-only development)
SCANNER_SERVICE_URL=http://localhost:5001
PHISHING_SERVICE_URL=http://localhost:5002
GIS_SERVICE_URL=http://localhost:5003
